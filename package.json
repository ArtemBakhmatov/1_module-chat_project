{
  "name": "chat-project",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "vite --port 3000",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "lint:scss": "npx stylelint \"**/*.scss\"",
    "lint:scss:fix": "npx stylelint \"**/*.scss\" --fix",
    "test": "mocha",
    "prepare": "husky install",
    "pre-commit": "npm-run-all test lint"
  },
  "husky": {
    "hooks": {
      "pre-commit": "npm-run-all test lint",
      "pre-push": "npm-run-all test lint"
    }
  },
  "devDependencies": {
    "@types/chai": "^5.0.1",
    "@types/jsdom": "^21.1.7",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.6",
    "@types/sinon": "^17.0.3",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "chai": "^5.1.2",
    "eslint": "^8.57.0",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "handlebars": "4.7.8",
    "husky": "^9.1.7",
    "jsdom": "^26.0.0",
    "mocha": "^11.0.1",
    "nanoid": "^5.0.7",
    "npm-run-all": "^4.1.5",
    "sass": "^1.77.8",
    "sinon": "^19.0.2",
    "stylelint": "^16.8.2",
    "stylelint-scss": "^6.5.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.2",
    "vite": "^4.4.5",
    "vite-plugin-checker": "^0.7.2"
  },
  "engines": {
    "node": "20"
  }
}
